{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "printWidth": 100,
  "htmlWhitespaceSensitivity": "ignore",
  "plugins": [
    "prettier-plugin-astro"
  ],
  "overrides": [
    {
      "files": [
        "**/*.astro"
      ],
      "options": {
        "parser": "astro"
      }
    }
  ]
}