---
import type { ProfileMeta, ProfileSection } from "../../lib/profile";
import Cards from "../../components/Cards.astro";
import GalleryCard from "../../components/GalleryCard.astro";
import InfoCard from "../../components/InfoCard.astro";
import LogbookCard from "../../components/LogbookCard.astro";
import Prose from "../../components/Prose.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SectionCluster from "../../components/SectionCluster.astro";

export const profile: ProfileMeta = {
  lang: "zh-cn",
  stationId: "BD4WXB",
  callsign: "BD4WXB",
  status: "inactive",
  pageTitle: "茶栗的个人业余电台",
  description: "个人业余无线电台 BD4WXB 的台站信息，QSL 说明，与图集展示。",
  hero: {
    quote: "忘れたくない想い、ありますか？",
    quoteSource: "ef - a tale of memories.",
  },
};

export const sections: readonly ProfileSection[] = [
  { id: "basic-info", label: "基本信息" },
  { id: "showcase", label: "展示" },
  { id: "logbook", label: "日志" },
];
---

<Prose>
  <p>
    欢迎来到我的个人业余无线电台主页。同时也欢迎去<a href="https://chariri.moe/">我的blog看看。</a>
  </p>
  <p>
    由于我已离开南京，呼号BD4WXB自2025年9月3日起停止使用。
    您可以用页面顶端的链接切换到我正在使用的呼号：JL1HRE。
  </p>
  <p>
    正如您所见，这个页面是vibecoding
    出来的，这也是我第一次vibecoding项目，结果花了远超预期的26个小时。
    我的感受是AI经常写出缺乏品味的代码。有了高性能的LLM模型，要vibecoding出能用的前端代码是很容易的事。
    但vibecoding出优雅、全面（比如您会发现这个页面有完善的I18n、A11y、打印、深色模式支持）、好看的代码很困难。不过这还是比从零开始写简单多了。
  </p>
  <p>
    关于我的业余无线电台的碎碎念放在了我的blog上，<a
      href="https://chariri.moe/archives/1957/amateur-radio/"
    >
      链接在这里。
    </a>
  </p>
</Prose>

<SectionBlock id="basic-info" title="基本信息">
  <Cards columns="2u">
    <InfoCard label="QTH" icon="grid">
      OL39
      <Fragment slot="description">CRAC 第8区 - 重庆</Fragment>
    </InfoCard>
    <InfoCard label="执照" icon="signal">
      中国业余无线电台B类操作证 + B类电台执照
      <Fragment slot="description">
        144 MHz @ 25 W<br />
        HF @ 15 W
      </Fragment>
    </InfoCard>
    <InfoCard label="联系邮箱" icon="email">
      <a href="mailto:chariri@chariri.moe">chariri@chariri.moe</a>
    </InfoCard>
    <InfoCard label="邮寄地址" icon="mail">
      210042 中华人民共和国 江苏省南京市21004294信箱
    </InfoCard>
  </Cards>

  <SectionCluster icon="gear" title="设备">
    <Cards columns="2">
      <InfoCard label="电台" icon="radio">
        欧讯 KG-UV9D (Plus)
        <Fragment slot="description">FM @ VHF (144 MHz), 5 W</Fragment>
      </InfoCard>
      <InfoCard label="电台" icon="radio">
        ICOM IC-7300
        <Fragment slot="description">SSB, FT8 @ HF, 15 W</Fragment>
      </InfoCard>
      <InfoCard label="天线" icon="antenna">
        钻石SRH771
        <Fragment slot="description">有点弯了，勉强能用。</Fragment>
      </InfoCard>
      <InfoCard label="天线" icon="antenna">依薇特通信BG8GVJ产短波便携正V P-SWA天线</InfoCard>
    </Cards>
  </SectionCluster>

  <SectionCluster icon="policy" title="QSL 政策">
    <Prose>
      <p>
        对于每次通联，我将在如下任一情况下寄送卡片：
        <ul>
          <li>通联时约定了如何寄送卡片；</li>
          <li>对方的地址能轻易在 QRZ.com 等地方查到，且此次通联不是比赛或 FT8 通联；</li>
          <li>我收到了对方寄来的卡片；</li>
        </ul>
      </p>
      <p>
        对于其它情况，我仅会将日志上传到本站、LoTW与QRZ.com，
        您亦可以通过上述邮箱地址或邮寄地址联系我寄卡，给我寄卡片或信件时无需附
        SASE。另外对于频繁通联的老朋友，我可能将合并寄送或不寄送其中的部分通联。
      </p>
      <p>如果没有在线下见过面，我<strong>不会交换</strong>Eyeball QSL 卡。</p>
    </Prose>
  </SectionCluster>
</SectionBlock>

<SectionBlock id="showcase" title="展示">
  <SectionCluster title="QSL 卡片" icon="gallery">
    <Cards columns="2">
      <GalleryCard
        src="/images/qsl/QSLCard.webp"
        alt="QSL 卡正面，可填写对方呼号与 QSL 确认种类，并带有可打印日期、频率、模式、信号报告、功率与备注的表格。"
        title="QSL v2 - 正面"
      >
        这版设计基于 <a href="https://forum.hamcq.cn/d/418">Shiro</a> aka BI3AR 的设计，并针对打印填写做了修改。
      </GalleryCard>
      <GalleryCard
        src="/images/qsl/QSLCard-Back.webp"
        alt="QSL 卡背面，图中为中文 VOCALOID 角色洛天依操作一整墙业余无线电设备，旁边有很大一个 BD4WXB 呼号牌。"
        title="QSL v2 - 背面"
      >
        背面 <a href="https://t.bilibili.com/1054583074411511815">插画</a> 由
        <a href="https://space.bilibili.com/524445763">乐韵Jewel</a> 绘制。
      </GalleryCard>
      <GalleryCard
        src="/images/qsl/QSLCard-v1.webp"
        alt="第一版 QSL 卡正面，可手写呼号、QSL 确认种类、日期、时间、模式、频率、信号报告、设备、功率与天线信息。"
        title="QSL v1 - 正面"
      >
        <a href="https://forum.hamcq.cn/d/418">设计</a> 出自 <a href="https://shiro.love/">Shiro</a> aka
        BI3AR。
      </GalleryCard>
      <GalleryCard
        src="/images/qsl/QSLCard-Back-v1.webp"
        alt="第一版 QSL 卡背面，以洛天依插画为背景，左上角写有 BD4WXB 和 茶栗chariri。"
        title="QSL v1 - 背面"
      >
        背面插画为 <a href="https://www.pixiv.net/artworks/99486679">「🍀」</a>，作者
        <a href="https://www.pixiv.net/users/418969">TID</a>。
      </GalleryCard>
    </Cards>
  </SectionCluster>

  <SectionCluster title="奖项" icon="award">
    <div class="max-w-3xl">
      <GalleryCard
        src="/images/award/202505zjvhf.avif"
        alt="2025 年 5 月 5 日浙江省 VHF DX Contest 奖状，背景是中国浙江省地图，左上角有浙江省业余无线电协会标志，BD4WXB 获得第 6 名，得分 251，右下角有编号 ZARA-VHF-1008。"
        title="2025五五节浙江 VHF DX 通信比赛"
      >
        <p>2025 年 5 月 5 日 浙江省业余无线电协会 浙江省 VHF DX 通信比赛</p>
        <p><strong>名次</strong>: 第 6 名</p>
        <p><strong>得分</strong>: 251</p>
      </GalleryCard>
    </div>
  </SectionCluster>
</SectionBlock>

<SectionBlock id="logbook" title="日志">
  <LogbookCard lang="zh-cn" callsign={profile.callsign} />
</SectionBlock>
