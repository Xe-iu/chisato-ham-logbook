---
import type { ProfileMeta, ProfileSection } from "../../lib/profile";
import Cards from "../../components/Cards.astro";
import InfoCard from "../../components/InfoCard.astro";
import LogbookCard from "../../components/LogbookCard.astro";
import Prose from "../../components/Prose.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SectionCluster from "../../components/SectionCluster.astro";

export const profile: ProfileMeta = {
  lang: "zh-cn",
  stationId: "JL1HRE",
  callsign: "JL1HRE",
  status: "active",
  pageTitle: "茶栗的个人业余电台",
  description: "个人业余无线电台 JL1HRE 的台站信息，QSL 说明，与图集展示。。",
  hero: {
    quote: "聴こえますか？真実のメロディ。",
    quoteSource: "ef - a tale of melodies.",
  },
};

export const sections: readonly ProfileSection[] = [
  { id: "basic-info", label: "基本信息" },
  { id: "showcase", label: "展示" },
  { id: "logbook", label: "日志" },
];
---

<Prose>
  <p>
    欢迎来到我的个人业余无线电台主页。同时也欢迎去<a href="https://chariri.moe/">我的blog看看。</a>
  </p>
  <p>
    这是我目前正在使用的业余无线电台呼号，设台在日本东京。
    您可以用页面顶端的链接切换到我先前使用的呼号：BD4WXB。
  </p>
  <p>
    正如您所见，这个页面是vibecoding
    出来的，这也是我第一次vibecoding项目，结果花了远超预期的26个小时。
    我的感受是AI经常写出缺乏品味的代码。有了高性能的LLM模型，要vibecoding出能用的前端代码是很容易的事。
    但vibecoding出优雅、全面（比如您会发现这个页面有完善的I18n、A11y、打印、深色模式支持）、好看的代码很困难。不过这还是比从零开始写简单多了。
  </p>
  <p>
    关于我的业余无线电台的碎碎念放在了我的blog上， <a
      href="https://chariri.moe/archives/1957/amateur-radio/"
    >
      链接在这里。
    </a>
  </p>
  <p>
    本电台同时设固定台与移动台，前者最大天线功率为 100W，用于目前唯一的短波设备
    IC-7300。后者用于手台。
  </p>
</Prose>

<SectionBlock id="basic-info" title="基本信息">
  <Cards columns="2u">
    <InfoCard label="QTH" icon="grid">
      PM95
      <Fragment slot="description">日本东京</Fragment>
    </InfoCard>
    <InfoCard label="执照" icon="license">
      日本一级业余无线技士 + 固定台 + 移动台
      <Fragment slot="description">
        144 / 430 MHz @ 50 W<br />
        HF @ 100 W
      </Fragment>
    </InfoCard>
    <InfoCard label="联系邮箱" icon="email">
      <a href="mailto:chariri@chariri.moe">chariri@chariri.moe</a>
    </InfoCard>
    <InfoCard label="邮寄地址" icon="mail"> 准备中 </InfoCard>
  </Cards>

  <SectionCluster icon="gear" title="设备">
    <Cards columns="2">
      <InfoCard label="电台" icon="radio">
        YAESU FT-70D
        <Fragment slot="description">FM / C4FM @ VHF/UHF (144 / 430 MHz), 5 W</Fragment>
      </InfoCard>
      <InfoCard label="电台" icon="radio">
        ICOM IC-7300
        <Fragment slot="description">SSB, FT8 @ HF, 100 W</Fragment>
      </InfoCard>
      <InfoCard label="天线" icon="antenna">依薇特通信BG8GVJ产短波便携正V P-SWA天线</InfoCard>
    </Cards>
  </SectionCluster>

  <SectionCluster icon="policy" title="QSL 政策">
    <Prose>
      <p>
        QSL卡片暂未准备完成，因此目前暂时不交换QSL卡片。与我通联的友台若想交换卡片可先邮件联系我，我在准备好卡片后会一并寄出。
      </p>
      <p>如果没有在线下见过面，我<strong>不会交换</strong>Eyeball QSL卡。</p>
      <p>其它QSL政策请参阅BD4WXB呼号的主页。</p>
    </Prose>
  </SectionCluster>
</SectionBlock>

<SectionBlock id="showcase" title="展示">
  <p>这里还什么也没有... 我会努力的...</p>
</SectionBlock>

<SectionBlock id="logbook" title="日志">
  <LogbookCard lang="zh-cn" callsign={profile.callsign} />
</SectionBlock>
