---
import type { ProfileMeta, ProfileSection } from "../../lib/profile";
import Cards from "../../components/Cards.astro";
import GalleryCard from "../../components/GalleryCard.astro";
import InfoCard from "../../components/InfoCard.astro";
import LogbookCard from "../../components/LogbookCard.astro";
import Prose from "../../components/Prose.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SectionCluster from "../../components/SectionCluster.astro";

export const profile: ProfileMeta = {
  lang: "zh-cn",
  stationId: "JL1HRE",
  callsign: "JL1HRE",
  status: "active",
  pageTitle: "茶栗的个人业余电台",
  description: "现行呼号 JL1HRE 的台站信息与 QSL 说明。",
  hero: {
    quote: "聴こえますか？真実のメロディ。",
    quoteSource: "ef - a tale of melodies.",
  },
};

export const sections: readonly ProfileSection[] = [
  { id: "basic-info", label: "基本信息" },
  { id: "showcase", label: "展示" },
  { id: "logbook", label: "日志" },
];
---

<Prose>
  <p>这是当前使用中的日本呼号页面。</p>
  <p>这里把常用操作信息、QSL 规则和设备备注集中在一个轻量静态站点里。</p>
</Prose>

<SectionBlock id="basic-info" title="基本信息">
  <Cards columns="2u">
    <InfoCard label="QTH" icon="grid">
      PM95
      <Fragment slot="description">日本东京</Fragment>
    </InfoCard>
    <InfoCard label="资格" icon="license">
      日本一级业余无线技士
      <Fragment slot="description">
        当前以便携 VHF/UHF 为主，并为未来的 HF 扩展预留空间。
      </Fragment>
    </InfoCard>
    <InfoCard label="联系邮箱" icon="mail">
      <a href="mailto:chariri@chariri.moe">chariri@chariri.moe</a>
    </InfoCard>
    <InfoCard label="优先 QSL" icon="mail">
      LoTW + Bureau
      <Fragment slot="description">成功通联后的纸卡交换也欢迎。</Fragment>
    </InfoCard>
  </Cards>

  <SectionCluster icon="gear" title="设备">
    <Cards columns="2">
      <InfoCard label="Rig" icon="radio">
        Yaesu FT5D + 手台短天线组
        <Fragment slot="description">
          当前用于日常操作、守听和外场测试的便携 V/UHF 主力设备链。
        </Fragment>
      </InfoCard>
      <InfoCard label="工作流" icon="gear">
        笔记本 + 日志整理流程
        <Fragment slot="description">
          以纸面和终端为主的轻量记录方式，方便后续整理和上传日志。
        </Fragment>
      </InfoCard>
      <InfoCard label="台站计划" icon="radio">
        HF 固定台筹备中
        <Fragment slot="description">
          馈线、天线和桌面布局都在逐步准备，后续会扩展为固定台配置。
        </Fragment>
      </InfoCard>
    </Cards>
  </SectionCluster>

  <SectionCluster icon="policy" title="QSL 政策">
    <Prose>
      <p>常规确认优先使用 LoTW。对于纪念性通联或排程，也欢迎通过 Bureau 或直寄交换纸质 QSL。</p>
      <p>如果需要修正日志或确认细节，发邮件是最快的方式。</p>
      <p>常规本地 V/UHF 通联建议优先使用电子确认。</p>
    </Prose>
  </SectionCluster>
</SectionBlock>

<SectionBlock id="showcase" title="展示">
  <SectionCluster title="QSL 卡片" icon="gallery">
    <Cards columns="2">
      <GalleryCard src="/images/qsl/QSLCard.webp" alt="现行 QSL 卡正面。" title="现行 QSL - 正面">
        现行版式保持整洁，适合打印并清晰展示台站信息。
      </GalleryCard>
      <GalleryCard
        src="/images/qsl/QSLCard-Back.webp"
        alt="现行 QSL 卡背面。"
        title="现行 QSL - 背面"
      >
        背面在书写空间、插图和确认信息之间做了平衡。
      </GalleryCard>
    </Cards>
  </SectionCluster>

  <SectionCluster title="资质 / 说明" icon="award">
    <Cards columns="3">
      <InfoCard label="资质" icon="award">
        一级操作资格
        <Fragment slot="description">
          为更广泛的操作权限和未来更完整的固定台建设提供基础。
        </Fragment>
      </InfoCard>
      <InfoCard label="操作风格" icon="signal">
        便携优先
        <Fragment slot="description"> 当前电台强调快速部署、简单检查和本地 V/UHF 试验。 </Fragment>
      </InfoCard>
      <InfoCard label="网站方针" icon="gear">
        静态优先
        <Fragment slot="description"> 保持必要信息清晰可读，不依赖重量级客户端逻辑。 </Fragment>
      </InfoCard>
    </Cards>
  </SectionCluster>
</SectionBlock>

<SectionBlock id="logbook" title="日志">
  <LogbookCard lang="zh-cn" callsign={profile.callsign} />
</SectionBlock>
