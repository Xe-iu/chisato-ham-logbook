---
import type { ProfileMeta, ProfileSection } from "../../lib/profile";
import Cards from "../../components/Cards.astro";
import InfoCard from "../../components/InfoCard.astro";
import LogbookCard from "../../components/LogbookCard.astro";
import Prose from "../../components/Prose.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SectionCluster from "../../components/SectionCluster.astro";

export const profile: ProfileMeta = {
  lang: "ja",
  stationId: "JL1HRE",
  callsign: "JL1HRE",
  status: "active",
  pageTitle: "茶栗の個人アマチュア無線局",
  description: "東京に設置している個人アマチュア無線局 JL1HRE の局情報、QSL 案内、ログページです。",
  hero: {
    quote: "聴こえますか？真実のメロディ。",
    quoteSource: "ef - a tale of melodies.",
  },
};

export const sections: readonly ProfileSection[] = [
  { id: "basic-info", label: "基本情報" },
  { id: "showcase", label: "展示" },
  { id: "logbook", label: "ログ" },
];
---

<Prose>
  <p>
    私のアマチュア無線局のホームページへようこそ。よければ <a href="https://chariri.moe/">
      私のブログ
    </a>
    ものぞいてみてください。
  </p>
  <p>
    これは現在使っているアマチュア無線のコールサインで、局は東京都に設置しています。ページ上部の
    リンクから、以前使っていたコールサインBD4WXBのページにも切り替えられます。
  </p>
  <p>
    ご覧の通り、このページはvibecodingで生成されました。
    これは私の初めてのvibecodeプロジェクトでしたが、結局26時間もかかってしまい、予想をはるかに上回る時間となりました。
    個人の印象では、AIが生成するコードは往々にして洗練さに欠けるものです。
    高性能なLLMモデルを使えば、「使える」フロントエンドコードをvibecodeするのは簡単です。
    しかし、洗練されていて、全面的（例えば、このページにはI18n、A11y、印刷、ダークモードを対応していること）、かつ視覚的にもダサくないなコードを生成するのは難しいものです。
    とはいえ、一から書くよりははるかに簡単です。
  </p>
  <p>
    アマチュア無線についてのつぶやきは主にブログに置いてあります。
    <a href="https://chariri.moe/archives/1957/amateur-radio/">リンクはこちらです。</a>
  </p>
  <p>
    この局には固定と移動局、両方の局免があります。
    前者は最大100Wまで許可されており、現時点で唯一の短波リグであるIC-7300に使っています。後者はハンディ機用です。
  </p>
</Prose>

<SectionBlock id="basic-info" title="基本情報">
  <Cards columns="2u">
    <InfoCard label="QTH" icon="grid">
      PM95
      <Fragment slot="description">東京都</Fragment>
    </InfoCard>
    <InfoCard label="資格" icon="license">
      日本第一級アマチュア無線技士 + 固定局局免 + 移動局局免
      <Fragment slot="description">
        144 / 430 MHz @ 50 W<br />
        HF @ 100 W
      </Fragment>
    </InfoCard>
    <InfoCard label="メールアドレス" icon="email">
      <a href="mailto:chariri@chariri.moe">chariri@chariri.moe</a>
    </InfoCard>
    <InfoCard label="郵送先" icon="mail">準備中</InfoCard>
  </Cards>

  <SectionCluster icon="gear" title="設備">
    <Cards columns="2">
      <InfoCard label="Rig" icon="radio">
        YAESU FT-70D
        <Fragment slot="description">FM / C4FM @ VHF/UHF (144 / 430 MHz), 5 W</Fragment>
      </InfoCard>
      <InfoCard label="Rig" icon="radio">
        ICOM IC-7300
        <Fragment slot="description">SSB, FT8 @ HF, 100 W</Fragment>
      </InfoCard>
      <InfoCard label="アンテナ" icon="antenna">
        依薇特通信 BG8GVJ 製 HF V型ポータブル P-SWA アンテナ
      </InfoCard>
    </Cards>
  </SectionCluster>

  <SectionCluster icon="policy" title="QSL ポリシー">
    <Prose>
      <p>
        QSLカードはまだ準備できていないため、現在は紙QSLカードの交換を行っていません。
        交信していただいた方でカード交換をご希望の場合は、まずメールでご連絡ください。
        カードの準備ができ次第、まとめて発送します。
      </p>
      <p>
        オフラインで実際に会ったことがない場合、Eyeball QSLカードは<strong>交換しません</strong>。
      </p>
      <p>その他のQSLポリシーについては、BD4WXBコールサインのページをご参照ください。</p>
    </Prose>
  </SectionCluster>
</SectionBlock>

<SectionBlock id="showcase" title="展示">
  <p>ここにはまだ何もありません……これから頑張ります。</p>
</SectionBlock>

<SectionBlock id="logbook" title="ログ">
  <LogbookCard lang="ja" callsign={profile.callsign} />
</SectionBlock>
