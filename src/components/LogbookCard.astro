---
import { getLocale, type LocaleId } from "../lib/i18n";

interface Props {
  lang: LocaleId;
  callsign: string;
}

const { lang, callsign } = Astro.props;
const t = getLocale(lang).logbook;
const dataUrl = "/logdata.json";
const indexUrl = "/logdata.callsign-3gram-index.json";
const dialogId = `logbook-dialog-${lang}-${callsign}`.toLowerCase();
const dialogTitleId = `${dialogId}-title`;
const dialogDescriptionId = `${dialogId}-description`;
const printSheetId = `${dialogId}-print`;
const resultsId = `${dialogId}-results`;
const tableDescriptionId = `${dialogId}-table-description`;
const tableHeaderCellClass =
  "px-3 py-2 border-b border-station-line font-mono text-ui-micro uppercase tracking-[0.16rem] text-station-soft";
const tableCellClass =
  "px-3 py-2 border-b border-station-line/70 align-baseline text-station-muted";
const messageCellClass = "px-5 py-6 text-left text-sm text-station-muted";
---

<section
  class="overflow-hidden print:shadow-none rounded-2xl \
  border border-station-line shadow-(--shadow-panel) bg-station-bg"
  data-logbook-root
  data-logbook-url={dataUrl}
  data-logbook-index-url={indexUrl}
  data-logbook-callsign={callsign}
  data-logbook-t={JSON.stringify(t)}
  data-logbook-dialog-id={dialogId}
  data-logbook-dialog-description-id={dialogDescriptionId}
>
  <noscript>
    <div
      class="m-4 px-4 py-4 rounded-xl \
      border border-station-line \
      bg-station-surface-subtle \
      text-sm leading-7 text-station-muted"
      role="note"
      aria-label={t.clusterTitle}
    >
      <p class="font-medium text-station-ink">{t.clusterTitle}</p>
      <p class="mt-2">{t.noscript}</p>
    </div>
    <style>
      .logbook-app {
        display: none !important;
      }
    </style>
  </noscript>

  <div class="logbook-app">
    <div class="border-b border-station-line p-2 sm:p-4">
      <label class="block">
        <span class="meta-label">{t.searchLabel}</span>
        <input
          type="search"
          class="mt-3 w-full transition \
          px-3 py-2 rounded-xl \
          border border-station-line shadow-sm \
          bg-station-surface-subtle text-sm text-station-ink placeholder:text-station-soft/70 \
          hover:border-station-accent/30 focus:border-station-accent/40"
          data-logbook-search
          placeholder={t.searchPlaceholder}
          autocomplete="off"
        />
      </label>
    </div>

    <div
      class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between \
      px-6 py-2 \
      border-b border-station-line"
    >
      <p
        id={resultsId}
        class="meta-label"
        data-logbook-results
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {t.loading}
      </p>
    </div>

    <p id={tableDescriptionId} class="sr-only">
      {t.intro}
      {t.clickHint}
    </p>

    <div class="overflow-x-auto">
      <div class="max-h-136 overflow-auto" data-logbook-viewport>
        <table
          class="w-full min-w-235 border-collapse text-left text-sm"
          aria-describedby={`${tableDescriptionId} ${resultsId}`}
        >
          <caption class="sr-only">{t.cardLabel}</caption>
          <colgroup>
            <col class="w-40" />
            <col class="w-24" />
            <col class="w-16" />
            <col class="w-16" />
            <col class="w-28" />
            <col class="w-28" />
            <col class="w-16" />
            <col class="w-16" />
          </colgroup>
          <thead class="sticky top-0 z-10 bg-station-surface-table-head print:static print:bg-white">
            <tr>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.utc}</th>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.callsign}</th>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.sent}</th>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.received}</th>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.txFreq}</th>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.rxFreq}</th>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.mode}</th>
              <th scope="col" class={tableHeaderCellClass}>{t.columns.txPower}</th>
            </tr>
          </thead>
          <tbody data-logbook-body>
            <tr>
              <td colspan="8" class={messageCellClass}>
                {t.loading}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <template data-logbook-message-template>
    <tr>
      <td colspan="8" class={messageCellClass} data-logbook-message-cell>
      </td>
    </tr>
  </template>

  <template data-logbook-spacer-template>
    <tr aria-hidden="true">
      <td colspan="8" class="p-0 border-0" data-logbook-spacer-cell></td>
    </tr>
  </template>

  <template data-logbook-row-template>
    <tr
      class="cursor-pointer transition hover:bg-station-surface-accent/45 \
      [&:has([data-logbook-open]:focus-visible)]:outline-3 \
      [&:has([data-logbook-open]:focus-visible)]:outline-offset-[-3px] \
      [&:has([data-logbook-open]:focus-visible)]:outline-station-accent"
      data-logbook-row
    >
      <td class={tableCellClass} data-logbook-utc></td>
      <td class={tableCellClass}>
        <button
          type="button"
          class="block w-full cursor-pointer text-left transition \
          font-mono text-station-ink \
          underline-offset-4 decoration-transparent \
          hover:text-station-accent-strong focus-visible:outline-none"
          aria-haspopup="dialog"
          data-logbook-index
          data-logbook-open
        >
        </button>
      </td>
      <td class={tableCellClass} data-logbook-sent></td>
      <td class={tableCellClass} data-logbook-received></td>
      <td class={tableCellClass} data-logbook-tx-freq></td>
      <td class={tableCellClass} data-logbook-rx-freq></td>
      <td class={tableCellClass} data-logbook-mode></td>
      <td class={tableCellClass} data-logbook-tx-power></td>
    </tr>
  </template>

  <template data-logbook-dialog-content-template>
    <p class="pb-6 text-sm text-station-muted" data-logbook-dialog-description></p>
    <dl class="grid gap-0" data-logbook-detail-list></dl>
  </template>

  <template data-logbook-print-sheet-template>
    <section id={printSheetId} class="hidden px-6 py-6 logbook-print-sheet">
      <div class="mx-auto max-w-4xl">
        <p class="meta-label">{t.clusterTitle}</p>
        <h2 class="mt-3 text-2xl font-semibold text-station-ink" data-logbook-print-title></h2>
        <p class="mt-4 text-sm text-station-muted" data-logbook-print-description></p>
        <dl class="mt-6 grid gap-0" data-logbook-print-detail-list></dl>
      </div>
    </section>
  </template>

  <template data-logbook-detail-row-template>
    <div
      class="grid items-start gap-2 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] md:items-baseline \
      md:gap-6 print:sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] \
      print:sm:items-baseline print:sm:gap-6"
      data-logbook-detail-row
    >
      <dt
        class="m-0 font-mono text-xs uppercase tracking-[0.1rem] text-station-soft"
        data-logbook-detail-label
      ></dt>
      <dd class="m-0 text-sm text-station-ink" data-logbook-detail-value></dd>
    </div>
  </template>

  <template data-logbook-dialog-template>
    <div id={dialogId} data-logbook-dialog class="fixed inset-0 z-50" hidden>
      <div class="absolute inset-0 bg-slate-950/60" data-logbook-close></div>
      <div
        class="relative flex min-h-full items-start justify-center overflow-y-auto \
        px-3 py-4 \
        sm:px-6 sm:py-8"
        data-logbook-close-surface
      >
        <div
          class="flex w-full max-w-4xl max-h-[calc(100dvh-2rem)] flex-col overflow-hidden rounded-2xl \
          border border-station-line \
          shadow-(--shadow-panel) \
          bg-station-bg"
          role="dialog"
          aria-modal="true"
          aria-labelledby={dialogTitleId}
          aria-describedby={dialogDescriptionId}
          tabindex="-1"
          data-logbook-panel
        >
          <div
            class="flex items-start justify-between gap-4 px-5 py-4 sm:px-6 \
            border-b border-station-line"
          >
            <div class="space-y-2">
              <p class="meta-label">{t.clusterTitle}</p>
              <h3
                id={dialogTitleId}
                class="text-xl font-semibold text-station-ink"
                data-logbook-dialog-title
              >
              </h3>
            </div>
            <button type="button" class="station-button" data-logbook-close>{t.close}</button>
          </div>
          <div class="min-h-0 overflow-y-auto p-5 sm:p-6" data-logbook-dialog-body></div>
        </div>
      </div>
    </div>
  </template>
</section>

<style is:global>
  body.logbook-printing-dialog > * {
    display: none !important;
  }

  body.logbook-printing-dialog > .logbook-print-sheet {
    display: block !important;
  }
</style>

<script is:inline>
  (() => {
    class LogbookCardController {
      constructor(root) {
        if (root.dataset.logbookReady === "true") {
          return;
        }

        root.dataset.logbookReady = "true";
        this.root = root;
        this.translations = JSON.parse(root.dataset.logbookT || "{}");
        this.fallbackCallsign = root.dataset.logbookCallsign || "";
        this.dataUrl = root.dataset.logbookUrl || "";
        this.indexUrl = root.dataset.logbookIndexUrl || "";
        this.dialogId = root.dataset.logbookDialogId || "";
        this.dialogDescriptionId = root.dataset.logbookDialogDescriptionId || "";
        this.printSheetId = `${this.dialogId}-print`;
        this.rowHeight = 36;
        this.overscan = 10;
        this.state = {
          all: [],
          filtered: [],
          callsignIndex: null,
          activeRowIndex: 0,
          query: "",
          renderPending: false,
          escapeHandler: null,
          triggerElement: null,
          currentEntry: null,
          wasDialogOpenBeforePrint: false,
          beforePrintHandler: null,
          afterPrintHandler: null,
          previousOverflow: {
            body: "",
            html: "",
          },
        };

        this.setupElements();
        this.bindEvents();
        this.loadData();
      }

      setupElements() {
        const dialogTemplate = this.root.querySelector("[data-logbook-dialog-template]");
        if (!document.getElementById(this.dialogId) && dialogTemplate) {
          document.body.append(dialogTemplate.content.cloneNode(true));
        }
        const printSheetTemplate = this.root.querySelector("[data-logbook-print-sheet-template]");
        if (!document.getElementById(this.printSheetId) && printSheetTemplate) {
          document.body.append(printSheetTemplate.content.cloneNode(true));
        }

        this.elements = {
          searchInput: this.root.querySelector("[data-logbook-search]"),
          resultsNode: this.root.querySelector("[data-logbook-results]"),
          viewport: this.root.querySelector("[data-logbook-viewport]"),
          body: this.root.querySelector("[data-logbook-body]"),
          messageTemplate: this.root.querySelector("[data-logbook-message-template]"),
          spacerTemplate: this.root.querySelector("[data-logbook-spacer-template]"),
          rowTemplate: this.root.querySelector("[data-logbook-row-template]"),
          dialogContentTemplate: this.root.querySelector("[data-logbook-dialog-content-template]"),
          printSheet: document.getElementById(this.printSheetId),
          detailRowTemplate: this.root.querySelector("[data-logbook-detail-row-template]"),
          dialog: document.getElementById(this.dialogId),
        };

        if (!this.elements.dialog) {
          return;
        }

        this.elements.dialogTitle = this.elements.dialog.querySelector(
          "[data-logbook-dialog-title]"
        );
        this.elements.dialogBody = this.elements.dialog.querySelector("[data-logbook-dialog-body]");
        this.elements.dialogPanel = this.elements.dialog.querySelector("[data-logbook-panel]");
        this.elements.closeButtons =
          this.elements.dialog.querySelectorAll("[data-logbook-close]") || [];
        if (this.elements.printSheet) {
          this.elements.printSheetTitle = this.elements.printSheet.querySelector(
            "[data-logbook-print-title]"
          );
          this.elements.printSheetDescription = this.elements.printSheet.querySelector(
            "[data-logbook-print-description]"
          );
          this.elements.printSheetDetailList = this.elements.printSheet.querySelector(
            "[data-logbook-print-detail-list]"
          );
        }
      }

      bindEvents() {
        this.elements.searchInput?.addEventListener("input", (event) => {
          this.state.query = event.target.value;
          this.applyFilter();
        });

        this.elements.viewport?.addEventListener("scroll", () => this.scheduleRender(), {
          passive: true,
        });

        this.elements.body?.addEventListener("click", (event) => {
          const row = this.findRecordRow(event.target);
          const entry = row ? this.findEntryFromRow(row) : null;
          if (entry) {
            this.state.activeRowIndex = Number(row.dataset.recordIndex);
            this.openDialog(entry, this.findTriggerElement(row, event.target));
          }
        });

        this.elements.body?.addEventListener("keydown", (event) => {
          const trigger =
            event.target instanceof Element ? event.target.closest("[data-logbook-open]") : null;
          if (!trigger || !this.state.filtered.length) {
            return;
          }

          const currentIndex = Number(trigger.dataset.logbookIndex);
          const pageSize = Math.max(
            1,
            Math.floor(
              (this.elements.viewport?.clientHeight || this.rowHeight * 6) / this.rowHeight
            )
          );
          let nextIndex = null;

          switch (event.key) {
            case "ArrowDown":
              nextIndex = currentIndex + 1;
              break;
            case "ArrowUp":
              nextIndex = currentIndex - 1;
              break;
            case "Home":
              nextIndex = 0;
              break;
            case "End":
              nextIndex = this.state.filtered.length - 1;
              break;
            case "PageDown":
              nextIndex = currentIndex + pageSize;
              break;
            case "PageUp":
              nextIndex = currentIndex - pageSize;
              break;
            default:
              return;
          }

          event.preventDefault();
          this.setActiveRowIndex(nextIndex, { focus: true });
        });

        this.elements.closeButtons?.forEach((button) => {
          button.addEventListener("click", () => this.closeDialog());
        });

        this.elements.dialog?.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) {
            return;
          }

          if (!event.target.closest("[data-logbook-panel]")) {
            this.closeDialog();
          }
        });

        this.state.beforePrintHandler = () => this.preparePrintSheet();
        this.state.afterPrintHandler = () => this.restoreAfterPrint();
        window.addEventListener("beforeprint", this.state.beforePrintHandler);
        window.addEventListener("afterprint", this.state.afterPrintHandler);
      }

      setResultsText(text) {
        if (this.elements.resultsNode) {
          this.elements.resultsNode.textContent = text;
        }
      }

      cloneTemplate(template) {
        return template instanceof HTMLTemplateElement ? template.content.cloneNode(true) : null;
      }

      fillTemplate(template, values) {
        return Object.entries(values).reduce(
          (result, [key, value]) => result.replaceAll(`{${key}}`, String(value)),
          template
        );
      }

      getFocusableElements(container) {
        if (!container) {
          return [];
        }

        return Array.from(
          container.querySelectorAll(
            'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ).filter((element) => !element.hasAttribute("hidden"));
      }

      normalizeText(value) {
        return typeof value === "string" ? value.trim() : "";
      }

      normalizeCallsign(value) {
        return this.normalizeText(value).toUpperCase();
      }

      formatField(value, suffix = "") {
        const normalized = this.normalizeText(value);
        return normalized ? `${normalized}${suffix}` : "";
      }

      parseAdifTime(dateValue, timeValue) {
        if (!dateValue || String(dateValue).length < 8) {
          return 0;
        }

        const time = `${timeValue || ""}`.padEnd(6, "0").slice(0, 6);
        const year = Number(String(dateValue).slice(0, 4));
        const month = Number(String(dateValue).slice(4, 6)) - 1;
        const day = Number(String(dateValue).slice(6, 8));
        const hour = Number(time.slice(0, 2));
        const minute = Number(time.slice(2, 4));
        const second = Number(time.slice(4, 6));

        return Math.floor(Date.UTC(year, month, day, hour, minute, second) / 1000);
      }

      formatDateTime(timestamp, useUtc) {
        if (!timestamp) {
          return "";
        }

        const date = new Date(timestamp * 1000);
        const year = useUtc ? date.getUTCFullYear() : date.getFullYear();
        const month = String((useUtc ? date.getUTCMonth() : date.getMonth()) + 1).padStart(2, "0");
        const day = String(useUtc ? date.getUTCDate() : date.getDate()).padStart(2, "0");
        const hours = String(useUtc ? date.getUTCHours() : date.getHours()).padStart(2, "0");
        const minutes = String(useUtc ? date.getUTCMinutes() : date.getMinutes()).padStart(2, "0");
        const seconds = String(useUtc ? date.getUTCSeconds() : date.getSeconds()).padStart(2, "0");

        return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
      }

      matchesCurrentProfile(record) {
        const stationCallsign = this.normalizeCallsign(
          record?.station_callsign ?? record?.selfCallsign
        );
        return stationCallsign.startsWith(this.fallbackCallsign.toUpperCase());
      }

      buildTrigrams(value) {
        const normalized = this.normalizeCallsign(value);
        if (normalized.length < 3) {
          return [];
        }

        const grams = new Set();
        for (let index = 0; index <= normalized.length - 3; index += 1) {
          grams.add(normalized.slice(index, index + 3));
        }

        return Array.from(grams);
      }

      parseCallsignIndex(payload) {
        const grams = payload?.grams;
        return grams && typeof grams === "object" ? grams : null;
      }

      normalizeRecord(record, recordIndex) {
        const timeOn = this.parseAdifTime(record.qso_date, record.time_on);
        const timeOff = this.parseAdifTime(
          record.qso_date_off || record.qso_date,
          record.time_off || record.time_on
        );

        const entry = {
          recordIndex,
          timeOn,
          timeOff,
          utcLabel: this.formatDateTime(timeOn, true),
          localLabel: this.formatDateTime(timeOn, false),
          selfCallsign: this.normalizeText(record.station_callsign),
          destCallsign: this.normalizeText(record.call),
          destCallsignSearch: this.normalizeCallsign(record.call),
          sentRst: this.normalizeText(record.rst_sent),
          receivedRst: this.normalizeText(record.rst_rcvd),
          txFreq: this.normalizeText(record.freq),
          rxFreq: this.normalizeText(record.freq_rx),
          txPower: this.normalizeText(record.tx_pwr),
          mode: this.normalizeText(record.mode),
          comment: this.normalizeText(record.comment_intl),
          qth: this.normalizeText(record.qth_intl),
          selfGridsquare: this.normalizeText(record.my_gridsquare),
          gridsquare: this.normalizeText(record.gridsquare),
          selfRig: this.normalizeText(record.my_rig_intl),
          propagationMode: this.normalizeText(record.prop_mode),
          satellite: this.normalizeText(record.sat_name),
        };

        return entry;
      }

      findIndexedRecordIds(query) {
        if (!this.state.callsignIndex) {
          return null;
        }

        const grams = this.buildTrigrams(query);
        if (!grams.length) {
          return null;
        }

        let matches = null;
        for (const gram of grams) {
          const recordIds = this.state.callsignIndex[gram];
          if (!Array.isArray(recordIds) || !recordIds.length) {
            return new Set();
          }

          const nextMatches = new Set(recordIds);
          if (matches === null) {
            matches = nextMatches;
            continue;
          }

          matches = new Set(Array.from(matches).filter((recordId) => nextMatches.has(recordId)));
          if (!matches.size) {
            return matches;
          }
        }

        return matches || new Set();
      }

      filterByCallsignQuery(query) {
        const normalizedQuery = this.normalizeCallsign(query);
        if (!normalizedQuery) {
          return this.state.all.slice();
        }

        if (normalizedQuery.length < 3) {
          return this.state.all.filter((entry) =>
            entry.destCallsignSearch.includes(normalizedQuery)
          );
        }

        const indexedRecordIds = this.findIndexedRecordIds(normalizedQuery);
        if (!indexedRecordIds) {
          return this.state.all.filter((entry) =>
            entry.destCallsignSearch.includes(normalizedQuery)
          );
        }

        return this.state.all.filter(
          (entry) =>
            indexedRecordIds.has(entry.recordIndex) &&
            entry.destCallsignSearch.includes(normalizedQuery)
        );
      }

      renderMessageRow(message) {
        if (!this.elements.body) {
          return;
        }

        const fragment = this.cloneTemplate(this.elements.messageTemplate);
        const cell = fragment?.querySelector("[data-logbook-message-cell]");
        if (!(cell instanceof HTMLTableCellElement)) {
          this.elements.body.replaceChildren();
          return;
        }

        cell.textContent = message;
        this.elements.body.replaceChildren(fragment);
      }

      createSpacerRow(height) {
        const fragment = this.cloneTemplate(this.elements.spacerTemplate);
        const cell = fragment?.querySelector("[data-logbook-spacer-cell]");
        if (!(cell instanceof HTMLTableCellElement)) {
          return null;
        }

        cell.style.height = `${height}px`;
        return fragment;
      }

      createDataRow(entry, index) {
        const fragment = this.cloneTemplate(this.elements.rowTemplate);
        if (!(fragment instanceof DocumentFragment)) {
          return null;
        }

        const row = fragment.querySelector("[data-logbook-row]");
        const button = fragment.querySelector("[data-logbook-open]");
        const utcCell = fragment.querySelector("[data-logbook-utc]");
        const sentCell = fragment.querySelector("[data-logbook-sent]");
        const receivedCell = fragment.querySelector("[data-logbook-received]");
        const txFreqCell = fragment.querySelector("[data-logbook-tx-freq]");
        const rxFreqCell = fragment.querySelector("[data-logbook-rx-freq]");
        const modeCell = fragment.querySelector("[data-logbook-mode]");
        const txPowerCell = fragment.querySelector("[data-logbook-tx-power]");

        if (
          !(row instanceof HTMLTableRowElement) ||
          !(button instanceof HTMLButtonElement) ||
          !(utcCell instanceof HTMLTableCellElement) ||
          !(sentCell instanceof HTMLTableCellElement) ||
          !(receivedCell instanceof HTMLTableCellElement) ||
          !(txFreqCell instanceof HTMLTableCellElement) ||
          !(rxFreqCell instanceof HTMLTableCellElement) ||
          !(modeCell instanceof HTMLTableCellElement) ||
          !(txPowerCell instanceof HTMLTableCellElement)
        ) {
          return null;
        }

        const openLabel = this.fillTemplate(this.translations.rowOpenLabelTemplate, {
          other: entry.destCallsign || this.fallbackCallsign,
          utc: entry.utcLabel || "",
        });

        row.dataset.recordIndex = String(index);
        utcCell.textContent = entry.utcLabel;
        button.textContent = entry.destCallsign;
        button.dataset.logbookIndex = String(index);
        button.setAttribute("aria-controls", this.dialogId);
        button.setAttribute("aria-label", openLabel);
        button.tabIndex = index === this.state.activeRowIndex ? 0 : -1;
        sentCell.textContent = entry.sentRst;
        receivedCell.textContent = entry.receivedRst;
        txFreqCell.textContent = this.formatField(entry.txFreq, " MHz");
        rxFreqCell.textContent = this.formatField(entry.rxFreq, " MHz");
        modeCell.textContent = entry.mode;
        txPowerCell.textContent = this.formatField(entry.txPower, " W");

        return fragment;
      }

      scheduleRender() {
        if (this.state.renderPending) {
          return;
        }

        this.state.renderPending = true;
        window.requestAnimationFrame(() => {
          this.state.renderPending = false;
          this.renderRows();
        });
      }

      renderRows() {
        if (!this.elements.body || !this.elements.viewport) {
          return;
        }

        if (!this.state.filtered.length) {
          this.renderMessageRow(
            this.state.query ? this.translations.noMatches : this.translations.empty
          );
          this.setResultsText(
            this.fillTemplate(this.translations.resultsTemplate, {
              visible: 0,
              total: this.state.all.length,
            })
          );
          return;
        }

        const viewportHeight = Math.max(this.elements.viewport.clientHeight, this.rowHeight * 6);
        const visibleCount = Math.ceil(viewportHeight / this.rowHeight);
        const start = Math.max(
          0,
          Math.floor(this.elements.viewport.scrollTop / this.rowHeight) - this.overscan
        );
        const end = Math.min(this.state.filtered.length, start + visibleCount + this.overscan * 2);
        const tabbableIndex =
          this.state.activeRowIndex >= start && this.state.activeRowIndex < end
            ? this.state.activeRowIndex
            : start;
        const topPad = start * this.rowHeight;
        const bottomPad = (this.state.filtered.length - end) * this.rowHeight;
        const fragment = document.createDocumentFragment();

        this.state.activeRowIndex = tabbableIndex;

        if (topPad > 0) {
          const spacer = this.createSpacerRow(topPad);
          if (spacer) {
            fragment.append(spacer);
          }
        }

        for (let index = start; index < end; index += 1) {
          const entry = this.state.filtered[index];
          const row = this.createDataRow(entry, index);
          if (row) {
            fragment.append(row);
          }
        }

        if (bottomPad > 0) {
          const spacer = this.createSpacerRow(bottomPad);
          if (spacer) {
            fragment.append(spacer);
          }
        }

        this.elements.body.replaceChildren(fragment);
        this.setResultsText(
          this.fillTemplate(this.translations.resultsTemplate, {
            visible: this.state.filtered.length,
            total: this.state.all.length,
          })
        );
      }

      createDetailRow(label, value, index) {
        const fragment = this.cloneTemplate(this.elements.detailRowTemplate);
        if (!(fragment instanceof DocumentFragment)) {
          return null;
        }

        const row = fragment.querySelector("[data-logbook-detail-row]");
        const labelNode = fragment.querySelector("[data-logbook-detail-label]");
        const valueNode = fragment.querySelector("[data-logbook-detail-value]");

        if (
          !(row instanceof HTMLDivElement) ||
          !(labelNode instanceof HTMLElement) ||
          !(valueNode instanceof HTMLElement)
        ) {
          return null;
        }

        if (index === 0) {
          row.classList.add("pb-2");
        } else {
          row.classList.add("border-t", "border-station-line", "py-2");
        }

        labelNode.textContent = label;
        valueNode.textContent = value;
        return fragment;
      }

      buildDetailRows(entry) {
        const rows = [
          [this.translations.details.startUtc, this.formatDateTime(entry.timeOn, true)],
          [this.translations.details.startLocal, this.formatDateTime(entry.timeOn, false)],
          [this.translations.details.endUtc, this.formatDateTime(entry.timeOff, true)],
          [this.translations.details.endLocal, this.formatDateTime(entry.timeOff, false)],
          [this.translations.details.sentRst, entry.sentRst],
          [this.translations.details.receivedRst, entry.receivedRst],
          [this.translations.details.txFreq, this.formatField(entry.txFreq, " MHz")],
          [this.translations.details.rxFreq, this.formatField(entry.rxFreq, " MHz")],
          [this.translations.details.txPower, this.formatField(entry.txPower, " W")],
          [this.translations.details.mode, entry.mode],
          [this.translations.details.comment, entry.comment],
          [this.translations.details.qth, entry.qth],
          [this.translations.details.rig, entry.selfRig],
          [this.translations.details.selfGrid, entry.selfGridsquare],
        ];

        if (entry.gridsquare) {
          rows.push([this.translations.details.otherGrid, entry.gridsquare]);
        }

        if (entry.propagationMode) {
          rows.push([this.translations.details.propagation, entry.propagationMode]);
        }

        if (entry.satellite) {
          rows.push([this.translations.details.satellite, entry.satellite]);
        }

        const fragment = document.createDocumentFragment();
        rows.forEach(([label, value], index) => {
          const detailRow = this.createDetailRow(label, value, index);
          if (detailRow) {
            fragment.append(detailRow);
          }
        });

        return fragment;
      }

      getDetailTitle(entry) {
        return this.fillTemplate(this.translations.detailTitleTemplate, {
          self: entry.selfCallsign || this.fallbackCallsign,
          other: entry.destCallsign || "",
        });
      }

      renderDetailContent(targetDescriptionNode, targetDetailList, entry) {
        if (!targetDescriptionNode || !targetDetailList) {
          return;
        }

        targetDescriptionNode.textContent = this.translations.details.noteTimezone;
        targetDetailList.replaceChildren(this.buildDetailRows(entry));
      }

      findRecordRow(target) {
        return target instanceof Element
          ? target.closest("[data-record-index]")
          : target?.parentElement?.closest("[data-record-index]") || null;
      }

      findEntryFromRow(row) {
        if (!row) {
          return null;
        }

        const index = Number(row.dataset.recordIndex);
        return this.state.filtered[index] || null;
      }

      findTriggerElement(row, target) {
        if (target instanceof Element) {
          const directTrigger = target.closest("[data-logbook-open]");
          if (directTrigger) {
            return directTrigger;
          }
        }

        return row?.querySelector("[data-logbook-open]") || null;
      }

      setActiveRowIndex(nextIndex, { focus = false } = {}) {
        if (!this.state.filtered.length) {
          this.state.activeRowIndex = -1;
          return;
        }

        const boundedIndex = Math.max(0, Math.min(nextIndex, this.state.filtered.length - 1));
        this.state.activeRowIndex = boundedIndex;
        this.scrollRowIntoView(boundedIndex);
        this.renderRows();

        if (focus) {
          window.requestAnimationFrame(() => {
            this.elements.body
              ?.querySelector(`[data-logbook-open][data-logbook-index="${boundedIndex}"]`)
              ?.focus();
          });
        }
      }

      scrollRowIntoView(index) {
        if (!this.elements.viewport) {
          return;
        }

        const rowTop = index * this.rowHeight;
        const rowBottom = rowTop + this.rowHeight;
        const viewportTop = this.elements.viewport.scrollTop;
        const viewportBottom = viewportTop + this.elements.viewport.clientHeight;

        if (rowTop < viewportTop) {
          this.elements.viewport.scrollTop = rowTop;
        } else if (rowBottom > viewportBottom) {
          this.elements.viewport.scrollTop = rowBottom - this.elements.viewport.clientHeight;
        }
      }

      lockScroll() {
        this.state.previousOverflow = {
          body: document.body.style.overflow,
          html: document.documentElement.style.overflow,
        };

        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
      }

      unlockScroll() {
        document.body.style.overflow = this.state.previousOverflow.body;
        document.documentElement.style.overflow = this.state.previousOverflow.html;
      }

      openDialog(entry, triggerElement = null) {
        if (
          !this.elements.dialog ||
          !this.elements.dialogTitle ||
          !this.elements.dialogBody ||
          !this.elements.dialogPanel
        ) {
          return;
        }

        this.elements.dialogTitle.textContent = this.getDetailTitle(entry);

        const dialogContent = this.cloneTemplate(this.elements.dialogContentTemplate);
        const descriptionNode = dialogContent?.querySelector("[data-logbook-dialog-description]");
        const detailList = dialogContent?.querySelector("[data-logbook-detail-list]");

        if (
          !(descriptionNode instanceof HTMLParagraphElement) ||
          !(detailList instanceof HTMLDListElement)
        ) {
          return;
        }

        descriptionNode.id = this.dialogDescriptionId;
        this.renderDetailContent(descriptionNode, detailList, entry);
        this.elements.dialogBody.replaceChildren(dialogContent);
        this.elements.dialog.hidden = false;
        this.lockScroll();
        this.state.currentEntry = entry;
        this.state.triggerElement =
          triggerElement instanceof HTMLElement
            ? triggerElement
            : document.activeElement instanceof HTMLElement
              ? document.activeElement
              : null;

        if (!this.state.escapeHandler) {
          this.state.escapeHandler = (event) => {
            if (event.key === "Escape") {
              event.preventDefault();
              this.closeDialog();
              return;
            }

            if (event.key !== "Tab") {
              return;
            }

            const focusableElements = this.getFocusableElements(this.elements.dialogPanel);
            if (!focusableElements.length) {
              event.preventDefault();
              this.elements.dialogPanel.focus();
              return;
            }

            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];
            const activeElement = document.activeElement;

            if (event.shiftKey && activeElement === firstElement) {
              event.preventDefault();
              lastElement.focus();
            } else if (!event.shiftKey && activeElement === lastElement) {
              event.preventDefault();
              firstElement.focus();
            }
          };
          document.addEventListener("keydown", this.state.escapeHandler);
        }

        window.requestAnimationFrame(() => {
          const [firstFocusable] = this.getFocusableElements(this.elements.dialogPanel);
          (firstFocusable || this.elements.dialogPanel).focus();
        });
      }

      closeDialog({ restoreFocus = true } = {}) {
        if (!this.elements.dialog || this.elements.dialog.hidden) {
          return;
        }

        this.elements.dialog.hidden = true;
        this.unlockScroll();

        if (this.state.escapeHandler) {
          document.removeEventListener("keydown", this.state.escapeHandler);
          this.state.escapeHandler = null;
        }

        if (restoreFocus && this.state.triggerElement instanceof HTMLElement) {
          this.state.triggerElement.focus();
        }
      }

      preparePrintSheet() {
        if (
          !this.elements.dialog ||
          this.elements.dialog.hidden ||
          !this.state.currentEntry ||
          !this.elements.printSheet ||
          !(this.elements.printSheetTitle instanceof HTMLElement) ||
          !(this.elements.printSheetDescription instanceof HTMLElement) ||
          !(this.elements.printSheetDetailList instanceof HTMLDListElement)
        ) {
          return;
        }

        this.state.wasDialogOpenBeforePrint = true;
        this.elements.printSheetTitle.textContent = this.getDetailTitle(this.state.currentEntry);
        this.renderDetailContent(
          this.elements.printSheetDescription,
          this.elements.printSheetDetailList,
          this.state.currentEntry
        );
        this.elements.printSheet.classList.remove("hidden");
        document.body.classList.add("logbook-printing-dialog");
        this.closeDialog({ restoreFocus: false });
      }

      restoreAfterPrint() {
        if (this.elements.printSheet) {
          this.elements.printSheet.classList.add("hidden");
        }

        document.body.classList.remove("logbook-printing-dialog");

        if (!this.state.wasDialogOpenBeforePrint || !this.state.currentEntry) {
          this.state.wasDialogOpenBeforePrint = false;
          return;
        }

        this.state.wasDialogOpenBeforePrint = false;
        this.openDialog(this.state.currentEntry, this.state.triggerElement);
      }

      applyFilter() {
        this.state.filtered = this.filterByCallsignQuery(this.state.query);
        this.state.activeRowIndex = this.state.filtered.length ? 0 : -1;

        if (this.elements.viewport) {
          this.elements.viewport.scrollTop = 0;
        }

        this.renderRows();
      }

      async loadData() {
        this.setResultsText(this.translations.loading);

        try {
          const [dataResponse, indexResponse] = await Promise.all([
            fetch(this.dataUrl),
            this.indexUrl
              ? fetch(this.indexUrl).catch((error) => {
                  console.error(error);
                  return null;
                })
              : Promise.resolve(null),
          ]);

          if (!dataResponse.ok) {
            throw new Error(`${dataResponse.status} ${dataResponse.statusText}`);
          }

          if (indexResponse?.ok) {
            const indexPayload = await indexResponse.json();
            this.state.callsignIndex = this.parseCallsignIndex(indexPayload);
          } else {
            this.state.callsignIndex = null;
          }

          const payload = await dataResponse.json();
          this.state.all = Array.isArray(payload.records)
            ? payload.records
                .map((record, recordIndex) => this.normalizeRecord(record, recordIndex))
                .filter((record) => this.matchesCurrentProfile(record))
                .sort((left, right) => right.timeOn - left.timeOn)
            : [];
          this.applyFilter();
        } catch (error) {
          console.error(error);
          this.renderMessageRow(`${this.translations.errorTitle} ${this.translations.errorBody}`);
          this.setResultsText(this.translations.errorTitle);
        }
      }
    }

    document.querySelectorAll("[data-logbook-root]").forEach((root) => {
      new LogbookCardController(root);
    });
  })();
</script>
