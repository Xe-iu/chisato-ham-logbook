---
import Icon from "./Icon.astro";

interface Props {
  label?: string;
  icon?: Parameters<typeof Icon>[0]["name"];
  largeText?: boolean;
}

const { label, icon, largeText = false } = Astro.props;
const hasTitle = Astro.slots.has("default");
const hasDescription = Astro.slots.has("description");
---

<article
  class="p-4 sm:p-5 rounded-xl border border-station-line bg-station-bg print:break-inside-avoid"
>
  {
    (label || icon) && (
      <div class="mb-0 flex items-start justify-between gap-3">
        <span class="meta-label-large">{label}</span>
        {icon && (
          <span class="icon-chip">
            <Icon name={icon} />
          </span>
        )}
      </div>
    )
  }
  {
    hasTitle && (
      <div class="text-lg font-semibold leading-tight text-station-ink">
        <slot />
      </div>
    )
  }
  {
    hasDescription && (
      <div
        class:list={[
          "text-station-muted",
          largeText ? "text-lg" : "text-base",
          hasTitle ? "mt-3" : "",
        ]}
      >
        <slot name="description" />
      </div>
    )
  }
</article>
