---
import Icon from "./Icon.astro";

interface Props {
  label?: string;
  value?: string;
  href?: string;
  icon?: Parameters<typeof Icon>[0]["name"];
  largeText?: boolean;
}

const { label, value, href, icon, largeText = false } = Astro.props;
const hasContent = Astro.slots.has("default");
---

<article
  class="rounded-[0.95rem] border border-station-line bg-[rgba(255,255,255,0.72)] p-4 sm:p-5"
  data-info-card
>
  {
    (label || icon) && (
      <div class="mb-0 flex items-start justify-between gap-3">
        <p class="meta-label-large">{label}</p>
        {icon && (
          <span class="icon-chip">
            <Icon name={icon} />
          </span>
        )}
      </div>
    )
  }
  {
    value &&
      (href ? (
        <a class="text-link text-lg font-semibold text-station-ink" href={href}>
          {value}
        </a>
      ) : (
        <p class="text-lg font-semibold leading-tight text-station-ink">{value}</p>
      ))
  }
  {
    hasContent && (
      <div
        class:list={[
          "space-y-4 leading-8 text-station-muted",
          largeText ? "text-lg" : "text-base",
          value ? "mt-3" : "",
        ]}
      >
        <slot />
      </div>
    )
  }
</article>
