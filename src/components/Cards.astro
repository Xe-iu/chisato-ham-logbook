---
interface Props {
  columns?: "2" | "2u" | "3" | "4";
}

const { columns = "3" } = Astro.props;
const classMap = {
  "2": "print:grid-cols-2 xl:grid-cols-2",
  "2u": "print:grid-cols-[1fr_2fr] xl:grid-cols-[1fr_2fr]",
  "3": "print:grid-cols-2 xl:grid-cols-3",
  "4": "sm:grid-cols-2 print:grid-cols-2 xl:grid-cols-4",
};
const classes = `grid gap-4 ${classMap[columns]}`;
---

<div class={`cards-grid ${classes}`}>
  <slot />
</div>
