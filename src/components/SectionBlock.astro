---
import SectionHeading from "./SectionHeading.astro";

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  class="section relative scroll-mt-32 print:scroll-mt-0 print:[break-inside:avoid] print:[page-break-inside:avoid] [&+&]:mt-14 [&+&]:border-t [&+&]:border-station-line [&+&]:pt-12"
  aria-labelledby={headingId}
>
  <SectionHeading id={headingId} title={title} />
  <div class="mt-6 space-y-7">
    <slot />
  </div>
</section>
