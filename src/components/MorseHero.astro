---
import { toMorse } from "../lib/morse";

interface Props {
  callsign: string;
  quote: string;
  overviewLabel: string;
  quoteSource?: string;
}

const { callsign, quote, overviewLabel, quoteSource } = Astro.props;
const cqText = "CQCQ DE";
const cqMorse = toMorse(cqText);
const callsignMorse = toMorse(callsign);
---

<section id="overview" class="space-y-8 border-b border-station-line pb-10">
  <h1
    class="sr-only print:not-sr-only print:block print:mb-4 \
    print:font-mono print:text-3xl print:font-bold print:tracking-[0.18em] \
    text-station-ink"
  >
    {callsign}
  </h1>

  <div class="space-y-5">
    <p class="meta-label print:hidden">{overviewLabel}</p>
    <div
      aria-hidden="true"
      class="max-w-5xl print:hidden p-5 sm:p-6 rounded-2xl \
      border border-[#34d39933] bg-[#071723fa]"
      data-morse-hero
      data-cq-text={cqText}
      data-cq-morse={cqMorse}
      data-callsign-text={callsign}
      data-callsign-morse={callsignMorse}
    >
      <div
        class="mb-5 flex items-center justify-between gap-4 \
        text-ui-micro uppercase tracking-[0.34em] text-[#6ee7b7b3]"
      >
        <span>TX</span>
        <span>{callsign}</span>
      </div>
      <pre
        class="overflow-x-auto whitespace-pre \
        font-mono text-lg tracking-[0.16em] text-[#d1fae5]"
        data-cq-text-target>{cqText}</pre>
      <pre
        class="mt-2 overflow-x-auto whitespace-pre \
        font-mono text-sm tracking-[0.18em] text-[#6ee7b7b3]"
        data-cq-morse-target>{cqMorse}</pre>
      <div class="my-5 h-px bg-[#34d39933]"></div>
      <pre
        class="overflow-x-auto whitespace-pre \
        font-mono text-[clamp(2.4rem,6vw,5.4rem)] font-bold tracking-[0.16em] text-[#d1fae5]"
        data-cs-text-target>{callsign}</pre>
      <pre
        class="mt-3 overflow-x-auto whitespace-pre \
        font-mono text-base tracking-[0.18em] text-[#6ee7b7b3]"
        data-cs-morse-target>{callsignMorse}</pre>
    </div>
  </div>

  <div class="max-w-4xl space-y-5">
    <blockquote class="relative pl-5 border-l-2 border-station-accent">
      <div
        aria-hidden="true"
        class="absolute -left-1 -top-3 pointer-events-none \
        font-serif text-[clamp(3rem,7vw,5rem)] leading-none text-station-accent-soft"
      >
        “
      </div>

      <p
        class="pr-6 \
        font-serif text-balance text-[clamp(2rem,4.4vw,3.35rem)] leading-normal tracking-[-0.035em] text-station-ink"
      >
        {quote}
      </p>
      {quoteSource && <cite class="mt-4 block not-italic meta-label">{quoteSource}</cite>}
    </blockquote>
  </div>
</section>

<style>
.is-typing::after {
  content: "_";
  margin-left: 0.18rem;
  color: currentColor;
  animation: terminal-blink 1s step-end infinite;
}

@keyframes terminal-blink {
  50% {
    opacity: 0;
  }
}

@media print {
  .is-typing::after {
    display: none;
  }
}
</style>

<script is:inline>
  const hero = document.querySelector("[data-morse-hero]");
  const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  function renderHeroFinal(target) {
    const cqTextTarget = target.querySelector("[data-cq-text-target]");
    const cqMorseTarget = target.querySelector("[data-cq-morse-target]");
    const csTextTarget = target.querySelector("[data-cs-text-target]");
    const csMorseTarget = target.querySelector("[data-cs-morse-target]");

    cqTextTarget.textContent = target.dataset.cqText || "";
    cqMorseTarget.textContent = target.dataset.cqMorse || "";
    csTextTarget.textContent = target.dataset.callsignText || "";
    csMorseTarget.textContent = target.dataset.callsignMorse || "";

    [cqTextTarget, cqMorseTarget, csTextTarget, csMorseTarget].forEach((node) => {
      node.classList.remove("is-typing");
    });
  }

  function resetHero(target) {
    const cqTextTarget = target.querySelector("[data-cq-text-target]");
    const cqMorseTarget = target.querySelector("[data-cq-morse-target]");
    const csTextTarget = target.querySelector("[data-cs-text-target]");
    const csMorseTarget = target.querySelector("[data-cs-morse-target]");

    [cqTextTarget, cqMorseTarget, csTextTarget, csMorseTarget].forEach((node) => {
      node.textContent = " ";
      node.classList.remove("is-typing");
    });
  }

  function animateLine(textTarget, morseTarget, textContent, morseContent, onComplete) {
    let morseProgress = 0;
    let textProgress = 0;
    let continuousSpaces = 0;

    textTarget.classList.add("is-typing");
    morseTarget.classList.add("is-typing");

    const interval = window.setInterval(() => {
      if (morseProgress >= morseContent.length) {
        window.clearInterval(interval);
        textTarget.textContent = textContent;
        morseTarget.textContent = morseContent;
        textTarget.classList.remove("is-typing");
        morseTarget.classList.remove("is-typing");
        onComplete?.();
        return;
      }

      const symbol = morseContent[morseProgress];
      morseProgress += 1;
      morseTarget.textContent = morseContent.slice(0, morseProgress);

      if (symbol !== " " || textProgress === 0) {
        if (continuousSpaces === 1 || textProgress === 0) {
          textProgress += 1;
        } else if (continuousSpaces > 1) {
          textProgress += 2;
        }

        textTarget.textContent = textContent.slice(0, textProgress);
        continuousSpaces = 0;
      } else {
        continuousSpaces += 1;
      }
    }, 50);

    return () => window.clearInterval(interval);
  }

  function playHero(target) {
    if (reduceMotionQuery.matches) {
      renderHeroFinal(target);
      return;
    }

    resetHero(target);

    const cqTextTarget = target.querySelector("[data-cq-text-target]");
    const cqMorseTarget = target.querySelector("[data-cq-morse-target]");
    const csTextTarget = target.querySelector("[data-cs-text-target]");
    const csMorseTarget = target.querySelector("[data-cs-morse-target]");
    const cleanup = [];

    cleanup.push(
      animateLine(
        cqTextTarget,
        cqMorseTarget,
        target.dataset.cqText || "",
        target.dataset.cqMorse || "",
        () => {
          const timeout = window.setTimeout(() => {
            cleanup.push(
              animateLine(
                csTextTarget,
                csMorseTarget,
                target.dataset.callsignText || "",
                target.dataset.callsignMorse || ""
              )
            );
          }, 180);
          cleanup.push(() => window.clearTimeout(timeout));
        }
      )
    );

    return () => cleanup.forEach((fn) => fn?.());
  }

  if (hero) {
    let stop = playHero(hero);

    reduceMotionQuery.addEventListener("change", () => {
      stop?.();
      stop = playHero(hero);
    });
  }
</script>
