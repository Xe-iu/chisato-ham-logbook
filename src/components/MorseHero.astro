---
import { toMorse } from "../lib/morse";

interface Props {
  callsign: string;
  quote: string;
  blurb: string;
  quoteSource?: string;
}

const { callsign, quote, blurb, quoteSource } = Astro.props;
const cqText = "CQCQ DE";
const cqMorse = toMorse(cqText);
const callsignMorse = toMorse(callsign);
---

<section id="overview" class="panel-shell overflow-hidden" data-section="overview">
  <div class="grid gap-6 p-6 lg:p-8">
    <div class="space-y-5">
      <div class="sr-only">
        <h1>{callsign}</h1>
        <p>{quote}</p>
      </div>

      <p class="hidden font-mono text-3xl font-bold tracking-[0.18em] text-station-ink print:block">
        {callsign}
      </p>

      <div
        aria-hidden="true"
        class="rounded-[1.75rem] border border-terminal-border bg-[rgba(7,23,35,1)] p-5 sm:p-6 print:hidden"
        data-morse-hero
        data-cq-text={cqText}
        data-cq-morse={cqMorse}
        data-callsign-text={callsign}
        data-callsign-morse={callsignMorse}
      >
        <div
          class="mb-5 flex items-center justify-between gap-4 text-[0.65rem] uppercase tracking-[0.34em] text-emerald-300/70"
        >
          <span>TX</span>
          <span>{callsign}</span>
        </div>
        <pre
          class="whitespace-pre-wrap wrap-break-word font-mono text-lg tracking-[0.16em] text-terminal-text"
          data-cq-text-target>
        </pre>
        <pre
          class="mt-2 whitespace-pre-wrap wrap-break-word font-mono text-sm tracking-[0.18em] text-terminal-text-muted"
          data-cq-morse-target>
        </pre>
        <div class="my-5 h-px bg-terminal-divider"></div>
        <pre
          class="whitespace-pre-wrap wrap-break-word font-mono text-[clamp(2.5rem,7vw,5.75rem)] font-bold tracking-[0.16em] text-terminal-text"
          data-cs-text-target>
        </pre>
        <pre
          class="mt-3 whitespace-pre-wrap wrap-break-word font-mono text-base tracking-[0.18em] text-terminal-text-muted"
          data-cs-morse-target>
        </pre>
      </div>

      <div class="space-y-4">
        <blockquote
          class="relative max-w-4xl overflow-hidden rounded-[1.75rem] border border-station-line-accent bg-[linear-gradient(180deg,rgba(255,255,255,0.88)_0%,rgba(255,255,255,0.72)_100%)] px-6 py-5 shadow-sm"
        >
          <div
            aria-hidden="true"
            class="-left-2 top-1 quotation-mark"
          >
            “
          </div>

          <p
            class="relative pr-2 pl-6 text-balance text-[clamp(1.7rem,4.6vw,3.2rem)] leading-[1.1] text-station-ink"
          >
            {quote}
          </p>
          {
            quoteSource && (
              <cite class="relative mt-4 block pr-2 pl-6 not-italic font-xs text-station-soft">
                {quoteSource}
              </cite>
            )
          }
          <div
            aria-hidden="true"
            class="-right-2 -bottom-2 quotation-mark"
          >
            ”
          </div>
        </blockquote>
        <p class="text-base leading-7 text-station-muted">
          {blurb}
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const hero = document.querySelector("[data-morse-hero]");
  const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  function renderHeroFinal(target) {
    const cqTextTarget = target.querySelector("[data-cq-text-target]");
    const cqMorseTarget = target.querySelector("[data-cq-morse-target]");
    const csTextTarget = target.querySelector("[data-cs-text-target]");
    const csMorseTarget = target.querySelector("[data-cs-morse-target]");

    cqTextTarget.textContent = target.dataset.cqText || "";
    cqMorseTarget.textContent = target.dataset.cqMorse || "";
    csTextTarget.textContent = target.dataset.callsignText || "";
    csMorseTarget.textContent = target.dataset.callsignMorse || "";

    [cqTextTarget, cqMorseTarget, csTextTarget, csMorseTarget].forEach((node) => {
      node.classList.remove("is-typing");
    });
  }

  function resetHero(target) {
    const cqTextTarget = target.querySelector("[data-cq-text-target]");
    const cqMorseTarget = target.querySelector("[data-cq-morse-target]");
    const csTextTarget = target.querySelector("[data-cs-text-target]");
    const csMorseTarget = target.querySelector("[data-cs-morse-target]");

    [cqTextTarget, cqMorseTarget, csTextTarget, csMorseTarget].forEach((node) => {
      node.textContent = " ";
      node.classList.remove("is-typing");
    });
  }

  function animateLine(textTarget, morseTarget, textContent, morseContent, onComplete) {
    let morseProgress = 0;
    let textProgress = 0;
    let continuousSpaces = 0;

    textTarget.classList.add("is-typing");
    morseTarget.classList.add("is-typing");

    const interval = window.setInterval(() => {
      if (morseProgress >= morseContent.length) {
        window.clearInterval(interval);
        textTarget.textContent = textContent;
        morseTarget.textContent = morseContent;
        textTarget.classList.remove("is-typing");
        morseTarget.classList.remove("is-typing");
        onComplete?.();
        return;
      }

      const symbol = morseContent[morseProgress];
      morseProgress += 1;
      morseTarget.textContent = morseContent.slice(0, morseProgress);

      if (symbol !== " " || textProgress === 0) {
        if (continuousSpaces === 1 || textProgress === 0) {
          textProgress += 1;
        } else if (continuousSpaces > 1) {
          textProgress += 2;
        }

        textTarget.textContent = textContent.slice(0, textProgress);
        continuousSpaces = 0;
      } else {
        continuousSpaces += 1;
      }
    }, 50);

    return () => window.clearInterval(interval);
  }

  function playHero(target) {
    if (reduceMotionQuery.matches) {
      renderHeroFinal(target);
      return;
    }

    resetHero(target);

    const cqTextTarget = target.querySelector("[data-cq-text-target]");
    const cqMorseTarget = target.querySelector("[data-cq-morse-target]");
    const csTextTarget = target.querySelector("[data-cs-text-target]");
    const csMorseTarget = target.querySelector("[data-cs-morse-target]");
    const cleanup = [];

    cleanup.push(
      animateLine(
        cqTextTarget,
        cqMorseTarget,
        target.dataset.cqText || "",
        target.dataset.cqMorse || "",
        () => {
          const timeout = window.setTimeout(() => {
            cleanup.push(
              animateLine(
                csTextTarget,
                csMorseTarget,
                target.dataset.callsignText || "",
                target.dataset.callsignMorse || ""
              )
            );
          }, 180);
          cleanup.push(() => window.clearTimeout(timeout));
        }
      )
    );

    return () => cleanup.forEach((fn) => fn?.());
  }

  if (hero) {
    let stop = playHero(hero);

    reduceMotionQuery.addEventListener("change", () => {
      stop?.();
      stop = playHero(hero);
    });
  }
</script>
