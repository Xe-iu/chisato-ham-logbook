---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  icon?: Parameters<typeof Icon>[0]["name"];
}

const { title, icon } = Astro.props;
---

<div class="space-y-4" data-section-cluster>
  <div class="flex items-center gap-3">
    {
      icon && (
        <span class="icon-chip shrink-0">
          <Icon name={icon} />
        </span>
      )
    }
    <h3
      class="font-sans text-[clamp(1.25rem,2vw,1.7rem)] leading-none tracking-[-0.04em] text-station-ink"
    >
      {title}
    </h3>
    <span class="h-px flex-1 bg-station-line/70" aria-hidden="true"></span>
  </div>
  <slot />
</div>
