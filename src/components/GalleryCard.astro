---
interface Props {
  src: string;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
---

<figure class="overflow-hidden border-y border-station-line bg-transparent" data-gallery-card>
  <figcaption class="border-b border-station-line px-4 pb-3 pt-4">
    <div class="mb-0 flex items-start justify-between gap-3">
      <p class="meta-label-large">{title}</p>
    </div>
  </figcaption>
  <div class="body-copy px-4 py-4">
    <slot />
  </div>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class="block h-auto w-full border-t border-station-line/70 bg-white"
  />
</figure>
