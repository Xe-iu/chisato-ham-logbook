---
interface Props {
  src: string;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
---

<figure
  class="overflow-hidden border-y border-station-line bg-transparent print:break-inside-avoid print:[page-break-inside:avoid] print:border-y-[rgb(28_23_19/0.18)] print:bg-white"
>
  <figcaption class="border-b border-station-line px-4 py-1">
    <div class="mb-0 flex items-start justify-between gap-3">
      <p class="meta-label-large">{title}</p>
    </div>
  </figcaption>
  <div class="px-4 py-4">
    <slot />
  </div>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class="block h-auto w-full border-t border-station-line/70 bg-white"
  />
</figure>
