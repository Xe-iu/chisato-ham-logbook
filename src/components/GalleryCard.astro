---
interface Props {
  src: string;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
---

<figure
  class="overflow-hidden border-y border-station-line bg-transparent \
  print:break-inside-avoid print:bg-white"
>
  <figcaption class="border-b border-station-line px-4 py-1">
    <div class="mb-0 flex items-start justify-between gap-3">
      <p class="meta-label-large">{title}</p>
    </div>
  </figcaption>
  <div class="px-4 py-4">
    <slot />
  </div>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class="block h-auto w-full border border-station-line bg-station-surface-subtle"
  />
</figure>
