---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="mb-6 grid gap-4 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-end">
  <div class="space-y-3">
    <p class="section-count font-mono text-[0.76rem] uppercase tracking-[0.24rem] text-station-accent-strong print:text-black"></p>
    <h2 id={id} class="font-sans text-[clamp(2rem,4vw,3.2rem)] leading-none text-station-ink">
      {title}
    </h2>
  </div>
  <div class="hidden h-px bg-station-line sm:block"></div>
</div>
