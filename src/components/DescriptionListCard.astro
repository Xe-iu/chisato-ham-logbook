---
import InfoCard from "./InfoCard.astro";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  icon?: Parameters<typeof Icon>[0]["name"];
}

const { title, icon = "mail" } = Astro.props;
---

<InfoCard label={title} icon={icon}>
  <div class="mt-4 space-y-4">
    <slot />
  </div>
</InfoCard>
