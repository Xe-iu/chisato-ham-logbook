---
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import type { LocaleContext, LocaleLink, StationStatus } from "../lib/i18n";
import type { ProfileMeta, ProfileSection } from "../lib/profile";

interface StationLink {
  id: string;
  callsign: string;
  status: StationStatus;
  statusLabel: string;
  href: string;
  current: boolean;
}

interface Props {
  profile: ProfileMeta;
  locale: LocaleContext;
  locales: readonly LocaleLink[];
  stations: readonly StationLink[];
  sections: readonly ProfileSection[];
}

const { profile, locale, locales, stations, sections } = Astro.props;
const title = `${profile.callsign} | ${locale.siteTitle}`;
const description = profile.description;
const mobileSections = sections.filter((section) => section.id !== "overview");
const desktopSectionNavLabel = locale.labels.sectionShortcuts;
const mobileSectionNavLabel = locale.labels.quickSectionShortcuts;
---

<!doctype html>
<html lang={locale.tag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="茶栗chariri" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <IconSprite />
    <div class="relative min-h-screen">
      <a
        href="#main-content"
        class="sr-only fixed left-4 top-4 z-[60] rounded-md border border-station-line bg-[rgba(252,249,244,0.98)] px-4 py-2 text-sm font-medium text-station-ink no-underline shadow-lg focus:not-sr-only"
      >
        {locale.skipToContent}
      </a>
      <header class="border-b border-station-line bg-[rgba(252,252,250,0.96)] print:bg-white">
        <div class="mx-auto max-w-[88rem] px-4 py-5 sm:px-6 lg:px-8">
          <div class="grid gap-5 lg:grid-cols-[minmax(0,1.2fr)_auto] lg:items-start print:block">
            <div class="flex min-w-0 items-center gap-4 print:gap-x-3">
              <a
                href="https://chariri.moe"
                aria-label={locale.labels.homeLink}
                class="shrink-0 rounded-[1rem] border border-station-line bg-[rgba(255,255,255,0.58)] p-1 no-underline"
              >
                <img
                  src="/images/head.webp"
                  alt=""
                  loading="lazy"
                  class="h-16 w-16 rounded-[0.8rem] object-cover print:h-14 print:w-14"
                />
              </a>
              <div class="min-w-0 space-y-1">
                <p class="meta-label">Chisato HAM Logbook</p>
                <p
                  class="font-sans text-[clamp(1.05rem,1.55vw,1.65rem)] leading-[1.08] text-station-ink"
                >
                  {profile.pageTitle}
                </p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-[auto_auto] lg:justify-end print:hidden">
              <nav
                class="border-l border-station-line pl-4"
                aria-label={locale.labels.languageSwitcher}
              >
                <div class="flex items-center justify-between gap-3">
                  <span class="meta-label">{locale.labels.language}</span>
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                  {
                    locales.map((locale) => (
                      <a
                        href={locale.href}
                        class="switch-pill"
                        data-active={locale.current}
                        aria-current={locale.current ? "page" : undefined}
                        aria-label={locale.languageName}
                      >
                        {locale.switchLabel}
                      </a>
                    ))
                  }
                </div>
              </nav>

              <nav
                class="border-l border-station-line pl-4"
                aria-label={locale.labels.stationSwitcher}
              >
                <div class="flex items-center justify-between gap-3">
                  <span class="meta-label">{locale.labels.station}</span>
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                  {
                    stations.map((station) => (
                      <a
                        href={station.href}
                        class="switch-pill gap-3"
                        data-active={station.current}
                        aria-current={station.current ? "page" : undefined}
                      >
                        <span class="font-mono text-sm tracking-[0.18em]">{station.callsign}</span>
                        <span
                          class:list={[
                            "rounded-md border border-transparent px-2 py-1 text-[0.62rem] uppercase tracking-[0.18em] print:border-[rgb(28_23_19_/_0.18)] print:bg-white print:text-black",
                            station.status === "active"
                              ? "border-station-line-accent-strong bg-station-surface-accent text-station-accent-strong"
                              : "border-station-line bg-station-surface-subtle text-station-muted",
                          ]}
                        >
                          {station.statusLabel}
                        </span>
                      </a>
                    ))
                  }
                </div>
              </nav>
            </div>
          </div>
        </div>
      </header>

      <div
        class="mx-auto grid max-w-[88rem] gap-10 px-4 pb-8 pt-8 sm:px-6 lg:grid-cols-[13rem_minmax(0,1fr)] lg:px-8 print:block print:max-w-none print:px-0 print:pb-0 print:pt-4"
      >
        <aside class="hidden lg:block print:hidden">
          <nav
            class="sticky top-10 border-l-2 border-station-line pl-4"
            aria-label={desktopSectionNavLabel}
          >
            <p class="meta-label">{locale.labels.sections}</p>
            <div class="mt-1 grid gap-1">
              {
                sections.map((section) => (
                  <a
                    href={`#${section.id}`}
                    class="block border-l-2 border-transparent py-1 pl-3 text-sm text-station-soft no-underline transition hover:border-station-line-accent hover:text-station-ink"
                  >
                    {section.label}
                  </a>
                ))
              }
            </div>
          </nav>
        </aside>

        <main id="main-content" tabindex="-1" class="min-w-0">
          <slot />
        </main>
      </div>

      <nav
        class="fixed inset-x-0 bottom-0 z-40 border-t border-station-line bg-[rgba(252,252,250,0.97)] print:hidden lg:hidden"
        aria-label={mobileSectionNavLabel}
      >
        <div
          class="mx-auto flex max-w-xl flex-wrap gap-2 px-4 pb-[calc(0.85rem+env(safe-area-inset-bottom))] pt-3"
        >
          {
            mobileSections.map((section) => (
              <a
                href={`#${section.id}`}
                class="grow rounded-md border border-station-line bg-[rgba(255,255,255,0.6)] px-3 py-3 text-center text-[0.72rem] font-medium text-station-muted no-underline"
              >
                {section.label}
              </a>
            ))
          }
        </div>
      </nav>

      <footer
        class="mx-auto mt-8 max-w-[88rem] border-t border-station-line px-4 pb-24 pt-5 text-sm text-station-muted sm:px-6 lg:px-8 lg:pb-10 print:mt-8 print:max-w-none print:px-0 print:pb-0"
      >
        <p>{locale.footer.copyright}</p>
        <p class="mt-1 min-h-5 max-w-3xl">
          {locale.footer.note}
        </p>
      </footer>
    </div>
  </body>
</html>
