---
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import type { LocaleContext, LocaleLink, StationStatus } from "../lib/i18n";
import type { ProfileMeta, ProfileSection } from "../lib/profile";

interface StationLink {
  id: string;
  callsign: string;
  status: StationStatus;
  statusLabel: string;
  href: string;
  current: boolean;
}

interface Props {
  profile: ProfileMeta;
  locale: LocaleContext;
  locales: readonly LocaleLink[];
  stations: readonly StationLink[];
  sections: readonly ProfileSection[];
}

const { profile, locale, locales, stations, sections } = Astro.props;
---

<!doctype html>
<html lang={locale.tag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="烨休YeXiu" />
    <meta name="description" content={profile.description} />
    <title>{`${profile.callsign} | ${locale.siteTitle}`}</title>
  </head>
  <body>
    <IconSprite />
    <div class="relative min-h-screen">
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only fixed left-4 top-4 z-60 px-4 py-2 \
        border border-station-line bg-station-surface-chrome text-sm font-medium text-station-ink"
      >
        {locale.skipToContent}
      </a>
      <header class="border-b border-station-line bg-station-surface-chrome">
        <div
          class="grid gap-5 lg:grid-cols-[minmax(0,1.2fr)_auto] lg:items-start mx-auto max-w-352 \
          px-4 py-5 sm:px-6 lg:px-8"
        >
          <div class="flex min-w-0 items-center gap-4 print:gap-x-3">
            <a
              href="https://blog.xeiu.top"
              aria-label={locale.labels.homeLink}
              class="shrink-0 no-underline p-1 rounded-2xl border border-station-line \
              bg-station-surface-translucent"
            >
              <img
                src="/images/head.webp"
                alt=""
                loading="lazy"
                class="h-16 w-16 print:h-14 print:w-14 object-cover rounded-xl"
              />
            </a>
            <div class="min-w-0 space-y-1">
              <p class="meta-label">Xe_iu HAM Logbook</p>
              <p class="font-sans text-[clamp(1.05rem,1.55vw,1.65rem)] text-station-ink">
                {profile.pageTitle}
              </p>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-[auto_auto] lg:justify-end print:hidden">
            <nav
              class="pl-4 border-l border-station-line"
              aria-label={locale.labels.stationSwitcher}
            >
              <div class="flex items-center justify-between gap-3">
                <span class="meta-label">{locale.labels.station}</span>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  stations.map((station) => (
                    <a
                      href={station.href}
                      class="station-button gap-3"
                      data-active={station.current}
                      aria-current={station.current ? "page" : undefined}
                    >
                      <span class="font-mono text-sm tracking-[0.16rem]">{station.callsign}</span>
                      <span
                        class:list={[
                          "px-2 py-1 rounded-md border border-transparent text-ui-badge uppercase tracking-[0.16rem]",
                          station.status === "active"
                            ? "border-station-line-accent-strong bg-station-surface-accent text-station-accent-strong"
                            : "border-station-line bg-station-surface-subtle text-station-muted",
                        ]}
                      >
                        {station.statusLabel}
                      </span>
                    </a>
                  ))
                }
              </div>
            </nav>
            <nav
              class="pl-4 border-l border-station-line"
              aria-label={locale.labels.languageSwitcher}
            >
              <div class="flex items-center justify-between gap-3">
                <span class="meta-label">{locale.labels.language}</span>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  locales.map((locale) => (
                    <a
                      href={locale.href}
                      class="station-button"
                      data-active={locale.current}
                      aria-current={locale.current ? "page" : undefined}
                      aria-label={locale.languageName}
                    >
                      {locale.switchLabel}
                    </a>
                  ))
                }
              </div>
            </nav>
          </div>
        </div>
      </header>

      <div
        class="grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] print:block mx-auto max-w-352 print:max-w-none \
        px-4 pt-8 pb-8 sm:px-6 lg:px-8 print:px-0 print:pt-4 print:pb-0"
      >
        <aside class="hidden lg:block print:hidden">
          <nav
            class="sticky top-10 pl-4 border-l-2 border-station-line"
            aria-label={locale.labels.sectionShortcuts}
          >
            <p class="meta-label">{locale.labels.sections}</p>
            <div class="mt-1 grid gap-1">
              {
                sections.map((section) => (
                  <a
                    href={`#${section.id}`}
                    class="block py-1 pl-3 no-underline transition border-l-2 border-transparent \
                    hover:border-station-line-accent text-sm text-station-soft hover:text-station-ink"
                  >
                    {section.label}
                  </a>
                ))
              }
            </div>
          </nav>
        </aside>

        <main id="main-content" tabindex="-1" class="min-w-0">
          <slot />
        </main>
      </div>

      <nav
        class="fixed inset-x-0 bottom-0 z-40 print:hidden lg:hidden \
        border-t border-station-line bg-station-surface-chrome"
        aria-label={locale.labels.sectionShortcuts}
      >
        <div
          class="flex flex-wrap gap-2 mx-auto max-w-xl \
          px-4 pt-3 pb-[calc(0.85rem+env(safe-area-inset-bottom))]"
        >
          {
            sections
              .filter((section) => section.id !== "overview")
              .map((section) => (
                <a
                  href={`#${section.id}`}
                  class="grow no-underline px-3 py-3 rounded-md 
                  border border-station-line bg-station-surface-translucent \
                  text-center text-ui-label font-medium text-station-muted"
                >
                  {section.label}
                </a>
              ))
          }
        </div>
      </nav>

      <footer
        class="mx-auto mt-8 print:mt-8 max-w-352 print:max-w-none \
        px-4 pt-5 pb-24 sm:px-6 lg:px-8 lg:pb-10 print:px-0 print:pb-0 border-t border-station-line \
        text-sm text-station-muted"
      >
        <p>Xe_iu HAM Logbook, Copyleft by 烨休YeXiu.</p>
        <p class="mt-1 min-h-5 max-w-3xl" set:html={locale.footer} />
      </footer>
    </div>
  </body>
</html>
