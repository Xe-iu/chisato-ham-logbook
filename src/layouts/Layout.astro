---
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import type { LocaleContext, LocaleLink, StationStatus } from "../lib/i18n";
import type { ProfileMeta, ProfileSection } from "../lib/profile";

interface StationLink {
  id: string;
  callsign: string;
  status: StationStatus;
  statusLabel: string;
  href: string;
  current: boolean;
}

interface Props {
  profile: ProfileMeta;
  locale: LocaleContext;
  locales: readonly LocaleLink[];
  stations: readonly StationLink[];
  sections: readonly ProfileSection[];
}

const { profile, locale, locales, stations, sections } = Astro.props;
const title = `${profile.callsign} | ${locale.siteTitle}`;
const description = profile.hero.blurb;
const mobileSections = sections.filter((section) => section.id !== "overview");
const desktopSectionNavLabel = "Section shortcuts";
const mobileSectionNavLabel = "Quick section shortcuts";
---

<!doctype html>
<html lang={locale.tag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="茶栗chariri" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <IconSprite />
    <div class="relative min-h-screen">
      <a href="#main-content" class="skip-link">{locale.skipToContent}</a>
      <header
        class="sticky top-0 z-50 border-b border-station-line bg-station-bg-start/90 backdrop-blur-xl print:static print:bg-white print:backdrop-blur-none"
      >
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
          <div
            class="flex flex-col gap-x-4 gap-y-1 lg:gap-4 lg:flex-row lg:items-center print:block"
          >
            <div class="flex-1 flex h-full flex-row items-center gap-x-4 print:gap-x-3">
              <a href="https://chariri.moe" title="Go to my blog">
                <img
                  src="/images/head.webp"
                  alt="Site Logo"
                  loading="lazy"
                  class="h-18 w-18 rounded-full transition-transform duration-300 hover:rotate-360 print:h-14 print:w-14"
                />
              </a>
              <div class="min-w-0">
                <p class="meta-label">Chisato HAM Logbook</p>
                <p class="mt-2 text-xl leading-6 text-station-muted">
                  {profile.pageTitle}
                </p>
              </div>
            </div>
            <nav
              class="h-full rounded-3xl border border-station-line bg-white/80 p-2 shadow-sm print:hidden"
              aria-label="Language switcher"
            >
              <div class="mt-1 flex items-center justify-between gap-3 px-2">
                <span class="meta-label">LANG</span>
              </div>
              <div class="mt-2 flex flex-wrap gap-2">
                {
                  locales.map((locale) => (
                    <a
                      href={locale.href}
                      class="switch-pill"
                      data-active={locale.current}
                      aria-current={locale.current ? "page" : undefined}
                      aria-label={locale.languageName}
                    >
                      {locale.switchLabel}
                    </a>
                  ))
                }
              </div>
            </nav>

            <nav
              class="h-full rounded-3xl border border-station-line bg-white/80 p-2 shadow-sm print:hidden"
              aria-label="Callsign switcher"
            >
              <div class="mt-1 flex items-center justify-between gap-3 px-2">
                <span class="meta-label">CALL</span>
              </div>
              <div class="mt-2 flex flex-wrap gap-2">
                {
                  stations.map((station) => (
                    <a
                      href={station.href}
                      class="switch-pill gap-3"
                      data-active={station.current}
                      aria-current={station.current ? "page" : undefined}
                    >
                      <span class="font-mono text-sm tracking-[0.18em]">{station.callsign}</span>
                      <span class="status-pill" data-status={station.status}>
                        {station.statusLabel}
                      </span>
                    </a>
                  ))
                }
              </div>
            </nav>
          </div>
        </div>
      </header>

      <div
        class="mx-auto flex max-w-7xl flex-col gap-8 px-4 pb-8 pt-8 sm:px-6 lg:px-8 print:block print:max-w-none print:px-0 print:pb-0 print:pt-4 lg:flex-row"
      >
        <aside class="hidden lg:block min-w-[16rem] print:hidden">
          <nav class="panel-shell sticky top-32 p-5" aria-label={desktopSectionNavLabel}>
            <p class="meta-label">NAV</p>
            <div class="mt-4 grid gap-2">
              {
                sections.map((section) => (
                  <a
                    href={`#${section.id}`}
                    class="rounded-2xl border border-station-line bg-white/70 px-4 py-2 text-left text-sm text-station-muted transition hover:border-station-accent/30 hover:bg-station-surface-accent/55"
                  >
                    {section.label}
                  </a>
                ))
              }
            </div>
          </nav>
        </aside>

        <main id="main-content" tabindex="-1">
          <slot />
        </main>
      </div>

      <nav
        class="fixed inset-x-0 bottom-0 z-40 border-t border-station-line bg-station-bg-start/90 backdrop-blur-xl print:hidden lg:hidden"
        aria-label={mobileSectionNavLabel}
      >
        <div
          class="mx-auto grid max-w-xl grid-cols-4 gap-2 px-4 pb-[calc(0.85rem+env(safe-area-inset-bottom))] pt-3"
        >
          {
            mobileSections.map((section) => (
              <a
                href={`#${section.id}`}
                class="rounded-2xl border border-white/60 bg-white/90 px-3 py-3 text-center text-xs font-medium text-station-muted shadow-sm"
              >
                {section.label}
              </a>
            ))
          }
        </div>
      </nav>

      <footer
        class="mx-auto max-w-7xl px-4 lg:pb-10 pb-24 text-sm text-station-muted sm:px-6 lg:px-8 print:mt-8 print:max-w-none print:px-0 print:pb-0"
      >
        <div class="panel-shell px-5 py-4">
          <p>{locale.footer.copyright}</p>
          <p class="mt-1 min-h-5">
            {locale.footer.note}
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
